# Copy to .env (local) or add these in Render -> Environment. Never commit real keys.

# --- AI model (any OpenAI-compatible API; default Groq: https://console.groq.com/keys) ---
LLM_API_KEY=
LLM_API_BASE_URL=https://api.groq.com/openai/v1
LLM_API_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low

# --- Backup provider (optional) when the main one's daily limit runs out, e.g. NVIDIA ---
LLM_FALLBACK_BASE_URL=          # e.g. https://integrate.api.nvidia.com/v1
LLM_FALLBACK_API_KEY=           # e.g. nvapi-...
LLM_FALLBACK_MODEL=             # e.g. openai/gpt-oss-20b

# --- Storage: a PostgreSQL URL (e.g. free Neon) makes it permanent; else a local SQLite file ---
DATABASE_URL=
DATA_DIR=data

# --- Website security ---
ACCESS_CODE=                    # protects the pharmacist pages (strongly recommended online)
CHECK_TOKEN=                    # a long random string; the daily GitHub Action sends it

# --- CDSCO pages to watch ---
CDSCO_ALERTS_URL=https://cdsco.gov.in/opencms/opencms/en/Alerts/
CDSCO_NSQ_URL=                  # the newer "NSQ Alerts" page, if you have its address

# --- Limits ---
MAX_REVIEWS_PER_RUN=15          # max AI calls per check (keeps free quotas safe)
LLM_TIMEOUT_SECONDS=120
