# Copy this file to sync.env (same folder as sync.py) and fill in both values.
# Never commit sync.env - it holds your token.

# Your MedAlert website (no / at the end)
SITE_URL=https://medicine-alert-agent.onrender.com

# The same value as CHECK_TOKEN in Render -> Environment
CHECK_TOKEN=

# Optional: extra CDSCO pages to read, comma-separated (e.g. the newer "NSQ Alerts" page)
CDSCO_PAGES=
